# StudyAI backend configuration.
#
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# Real environment variables always override values in `.env`.
# Never commit a real `.env` or any secret. This file contains no secrets.

# Interface to bind. Use 0.0.0.0 to accept connections from other devices
# (e.g. the Android tablet); use 127.0.0.1 for local-only access.
STUDYAI_HOST=127.0.0.1

# TCP port to listen on (1-65535).
STUDYAI_PORT=8000

# Development mode: enables uvicorn auto-reload and FastAPI debug output.
STUDYAI_DEV_MODE=false

# Uvicorn log level (e.g. critical, error, warning, info, debug, trace).
STUDYAI_LOG_LEVEL=info

# --- Resource limits -----------------------------------------------------------------
# Requests that exceed these limits are rejected with an explicit error
# (413 request_too_large, or 400 invalid_request for overlong fields); nothing
# is silently truncated. All values are positive integers.

# Maximum accepted request body size, in bytes (default 1 MiB).
STUDYAI_MAX_REQUEST_BYTES=1048576

# Maximum length of a generate `topic`, in characters.
STUDYAI_MAX_TOPIC_LENGTH=500

# Maximum length of `additionalInstructions`, in characters.
STUDYAI_MAX_INSTRUCTION_LENGTH=2000

# Maximum length of an explain `question`, in characters.
STUDYAI_MAX_QUESTION_LENGTH=2000

# Maximum serialized size of an embedded visualization document, in bytes.
STUDYAI_MAX_DOCUMENT_BYTES=524288

# Maximum length of the generate `context` field, in characters.
STUDYAI_MAX_EXPLANATION_CONTEXT_LENGTH=4000

# --- AI provider ---------------------------------------------------------------------
# Which AI provider backs generation. "opencode" enables the local OpenCode
# adapter; any other value disables generation (the endpoint returns 503).
STUDYAI_AI_PROVIDER=opencode

# Base URL of the local OpenCode server. Must be a loopback or private address;
# the server must never be exposed publicly. The bare name OPENCODE_BASE_URL is
# also accepted.
STUDYAI_OPENCODE_BASE_URL=http://127.0.0.1:4096

# Timeout (seconds) for a single generation request (1-600).
STUDYAI_OPENCODE_TIMEOUT_SECONDS=120

# Retries after a failed generation attempt, in addition to the first attempt
# (0-10). Transient failures and invalid output are retried; auth/permanent
# errors are not.
STUDYAI_OPENCODE_MAX_RETRIES=2

# Optional HTTP Basic credentials, only if the OpenCode server requires them.
# Leave unset otherwise. Never commit real values.
# STUDYAI_OPENCODE_SERVER_USERNAME=
# STUDYAI_OPENCODE_SERVER_PASSWORD=
