  "explanations": [
    {
      "id": "exp_center",
      "title": "Centre",
      "body": "Every point on the circle is the same distance from the centre. Here the centre is the origin (0, 0).",
      "relatedElements": [
        "radius",
        "diameter"
      ]
    },
    {
      "id": "exp_radius",
      "title": "Radius r = 2.4",
      "body": "The radius is the distance from the centre to any point on the circle. Here r = 2.4.",
      "relatedElements": [
        "center",
        "diameter"
      ]
    },
    {
      "id": "exp_diameter",
      "title": "Diameter d = 4.8",
      "body": "The diameter passes through the centre and equals twice the radius: d = 2r = 4.8.",
      "relatedElements": [
        "radius",
        "center"
      ]
    },
    {
      "id": "exp_circumference",
      "title": "Circumference C = 2πr",
      "body": "The circumference is the distance around the circle: C = 2πr ≈ 2 × 3.14 × 2.4 ≈ 15.1.",
      "relatedElements": [
        "radius"
      ],
      "keyTerms": [
        {
          "term": "π (pi)"
        }
      ]
    }
  ]
