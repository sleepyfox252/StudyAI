  "explanations": [
    {
      "id": "exp_parabola",
      "title": "The graph of y = x² − 4",
      "body": "This is a parabola opening upwards. It is the graph of the quadratic function y = x² − 4, shifted down by 4 from the basic parabola y = x².",
      "relatedElements": [
        "vertex",
        "root-a",
        "root-b"
      ],
      "keyTerms": [
        {
          "term": "parabola",
          "explanationId": "exp_root_a"
        }
      ],
      "childTopics": [
        {
          "topic": "shifting quadratic graphs",
          "subject": "mathematics"
        }
      ]
    },
    {
      "id": "exp_root_a",
      "title": "First root at x = −2",
      "body": "Substituting x = −2 gives y = (−2)² − 4 = 0, so the graph crosses the x-axis here. A value of x where y = 0 is called a root or zero of the function.",
      "relatedElements": [
        "root-b",
        "vertex"
      ]
    },
    {
      "id": "exp_root_b",
      "title": "Second root at x = 2",
      "body": "Substituting x = 2 gives y = 2² − 4 = 0. By symmetry the two roots sit at x = −2 and x = 2, equidistant from the axis of symmetry x = 0.",
      "relatedElements": [
        "root-a"
      ]
    },
    {
      "id": "exp_vertex",
      "title": "The vertex",
      "body": "The vertex is the lowest point of this parabola, at (0, −4). It lies on the axis of symmetry, midway between the two roots.",
      "relatedElements": [
        "root-a",
        "root-b"
      ]
    }
  ]
}
