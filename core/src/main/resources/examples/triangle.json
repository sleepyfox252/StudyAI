  "explanations": [
    {
      "id": "exp_va",
      "title": "Vertex A and the right angle",
      "body": "A is the corner where sides AB and CA meet. The small square marks a 90° right angle, making ABC a right triangle.",
      "relatedElements": [
        "side-ab",
        "side-ca"
      ]
    },
    {
      "id": "exp_vb",
      "title": "Vertex B",
      "body": "B joins the horizontal side AB with the hypotenuse BC.",
      "relatedElements": [
        "side-ab",
        "side-bc"
      ]
    },
    {
      "id": "exp_vc",
      "title": "Vertex C",
      "body": "C joins the vertical side CA with the hypotenuse BC.",
      "relatedElements": [
        "side-ca",
        "side-bc"
      ]
    },
    {
      "id": "exp_ab",
      "title": "Side AB = 4",
      "body": "The horizontal leg from A to B has length 4.",
      "relatedElements": [
        "vertex-a",
        "vertex-b"
      ]
    },
    {
      "id": "exp_bc",
      "title": "Side BC = 5 (hypotenuse)",
      "body": "The hypotenuse is opposite the right angle. Its length follows from the Pythagorean theorem: 3² + 4² = 5².",
      "relatedElements": [
        "side-ab",
        "side-ca"
      ],
      "keyTerms": [
        {
          "term": "hypotenuse",
          "explanationId": "exp_ab"
        }
      ]
    },
    {
      "id": "exp_ca",
      "title": "Side CA = 3",
      "body": "The vertical leg from C to A has length 3. Together 3, 4 and 5 form a Pythagorean triple.",
      "relatedElements": [
        "vertex-c",
        "vertex-a"
      ]
    }
  ]
}
