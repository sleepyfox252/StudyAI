  "explanations": [
    {
      "id": "exp_vec_a",
      "title": "Vector a",
      "body": "Vector a has components (3, 1): 3 units right and 1 unit up. Its length is √(3² + 1²) ≈ 3.16.",
      "relatedElements": [
        "vector-b",
        "resultant"
      ]
    },
    {
      "id": "exp_vec_b",
      "title": "Vector b",
      "body": "Vector b has components (1, 3): 1 unit right and 3 units up. Its length is √(1² + 3²) ≈ 3.16.",
      "relatedElements": [
        "vector-a",
        "resultant"
      ]
    },
    {
      "id": "exp_resultant",
      "title": "Resultant a + b",
      "body": "Adding tip-to-tail, the resultant is a + b = (3 + 1, 1 + 3) = (4, 4). The faint lines complete the parallelogram.",
      "relatedElements": [
        "vector-a",
        "vector-b"
      ],
      "keyTerms": [
        {
          "term": "resultant vector"
        }
      ]
    }
  ]
